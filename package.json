{
    "name": "Hive",
    "version": "0.2.26",
    "author": "hackolade",
    "engines": {
        "hackolade": "7.7.10",
        "hackoladePlugin": "1.2.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "HIVE",
            "title": "Apache Hive",
            "versions": [
                "1.x",
                "2.x",
                "3.x",
                "4.x"
            ]
        },
        "features": {
            "views": {
                "enabled": true,
                "viewLevel": "model",
                "disablePipelines": true,
                "includeViews": true
            },
            "forwardEngineering": {
                "jsonSchema": {
                    "keepParentType": {
                        "date": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                }
            },
            "nestedCollections": false,
            "disablePatternField": true,
            "enableForwardEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "excel": true,
                "plugin": true,
                "dbt": true
            },
            "disableMultipleTypes": false,
            "enableReverseEngineering": true,
            "enableComplexTypesNormalization": true,
            "generateAssociativeEntitiesForManyToManyRelationships": true,
            "disableChoices": false,
            "enableJsonType": true,
            "relationships": {
                "compositeRelationships": {
                    "allowRelationshipsByProperties": [
                        "primaryKey",
                        "unique",
                        "compositeUniqueKey",
                        "compositePrimaryKey"
                    ]
                }
            },
            "FEScriptCommentsSupported": [
                "2.x",
                "3.x",
                "4.x"
            ],
            "discoverRelationships": true,
            "enableKeysMultipleAbrr": true
        }
    },
    "description": "Hackolade plugin for Apache Hive",
    "dependencies": {
        "antlr4": "4.8.0",
        "async": "2.6.4",
        "big.js": "5.2.2",
        "lodash": "4.18.1",
        "ssl-root-cas": "1.3.1",
        "thrift": "0.15.0",
        "uuid": "14.0.0"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.27.3",
        "esbuild-node-externals": "1.20.1",
        "esbuild-plugin-clean": "1.0.1",
        "esbuild-plugin-copy": "2.1.1",
        "lint-staged": "16.2.7",
        "oxlint": "1.38.0",
        "oxlint-tsgolint": "0.10.1",
        "prettier": "3.8.1",
        "simple-git-hooks": "2.13.1"
    },
    "overrides": {
        "minimatch": "10.2.4"
    }
}